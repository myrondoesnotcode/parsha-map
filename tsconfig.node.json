{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "composite": true,
    "outDir": "node_modules/.tmp/tsconfig.node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "scripts", "src/redesign/weekRules.ts", "src/types/parsha.ts", "src/data/parshaList.json", "src/redesign/story.ts", "src/redesign/placeText.ts", "src/redesign/art/briefs.ts"]
}
